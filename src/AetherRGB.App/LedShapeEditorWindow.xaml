<Window x:Class="AetherRGB.App.LedShapeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AetherRGB — LED-Anordnung" Width="980" Height="740" MinWidth="900" MinHeight="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource BrushBackground}" Foreground="{StaticResource BrushText}" FontFamily="Segoe UI">
    <!-- Hintergrund explizit: der implizite Window-Stil aus App.xaml greift nur für exakt "Window",
         nicht für abgeleitete Fenster — ohne das blieb das Fenster Windows-weiß unter hellem Text. -->
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==== Linke Spalte: Formwahl ==== -->
        <DockPanel Grid.Column="0" Margin="0,0,20,0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock x:Name="DeviceNameText" Text="Gerät" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="ReportedCountText" Style="{StaticResource MutedText}" Margin="0,4,0,18" TextWrapping="Wrap" />

                <TextBlock Text="Anordnung" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                <RadioButton x:Name="KindLine" Content="Schnur (gerade)" GroupName="Kind" Foreground="{StaticResource BrushText}" Margin="0,3" Checked="OnKindChanged" />
                <RadioButton x:Name="KindCircle" Content="Kreis (z. B. Lüfter)" GroupName="Kind" Foreground="{StaticResource BrushText}" Margin="0,3" Checked="OnKindChanged" />
                <RadioButton x:Name="KindSquare" Content="Quadrat / Rahmen" GroupName="Kind" Foreground="{StaticResource BrushText}" Margin="0,3" Checked="OnKindChanged" />
                <RadioButton x:Name="KindCustom" Content="Frei zeichnen" GroupName="Kind" Foreground="{StaticResource BrushText}" Margin="0,3" Checked="OnKindChanged" />

                <StackPanel x:Name="PresetPanel" Margin="0,16,0,0">
                    <TextBlock Text="Anzahl LEDs" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                    <TextBox x:Name="LedCountBox" Width="100" HorizontalAlignment="Left" TextChanged="OnLedCountChanged" />
                </StackPanel>

                <StackPanel x:Name="CustomPanel" Margin="0,16,0,0">
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Klicke die LEDs in der Reihenfolge an, in der sie am Gerät verdrahtet sind — das erste Pixel ist LED 1. Mit gedrückter Maustaste kannst du durchziehen, Rechtsklick entfernt eine LED. Wo auf der Matrix du zeichnest, ist egal." />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Rückgängig" Margin="0,0,8,0" Click="OnUndoClick" />
                        <Button Content="Leeren" Click="OnClearClick" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="CountText" FontWeight="SemiBold" Margin="0,18,0,0" />
                <TextBlock x:Name="HoverText" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Speichern" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="OnSaveClick" />
                <Button Content="Abbrechen" Click="OnCancelClick" />
            </StackPanel>
        </DockPanel>

        <!-- ==== Rechte Spalte: 100x100-Matrix ==== -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10" Margin="0">
            <Viewbox Stretch="Uniform">
                <Canvas x:Name="MatrixCanvas" Width="600" Height="600" Background="#101117" ClipToBounds="True"
                        MouseLeftButtonDown="OnMatrixLeftDown" MouseRightButtonDown="OnMatrixRightDown"
                        MouseMove="OnMatrixMouseMove" MouseLeftButtonUp="OnMatrixLeftUp" MouseLeave="OnMatrixMouseLeave" />
            </Viewbox>
        </Border>
    </Grid>
</Window>
