<Window x:Class="AetherRGB.App.LayoutEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AetherRGB — Layout-Editor" Height="760" Width="1100" Background="#121212"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Geräte-Layout — ziehen, an der Ecke skalieren, am oberen Griff drehen"
                       Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button x:Name="SaveButton" Content="Speichern" Padding="12,6" Margin="0,0,8,0" Click="OnSaveClick" />
            <Button x:Name="ResetButton" Content="Position zurücksetzen" Padding="12,6" Margin="0,0,8,0" Click="OnResetClick" />
            <Button x:Name="CloseButton" Content="Schließen" Padding="12,6" Click="OnCloseClick" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#2E2E2E" BorderThickness="1" Background="#0B0B0B">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="LayoutCanvas" Width="1000" Height="1000" Background="#0B0B0B" ClipToBounds="False" />
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="HintText" Grid.Row="2" Margin="0,8,0,0" Foreground="#6B7280"
                   Text="Tipp: Die Rechteckbreite entspricht der Anordnung der LEDs entlang der langen Seite — so wie die LEDs real am Gehäuse verlaufen." />
    </Grid>
</Window>
