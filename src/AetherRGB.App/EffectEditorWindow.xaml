<Window x:Class="AetherRGB.App.EffectEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AetherRGB — Effekt-Editor" Width="1440" Height="880" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource BrushBackground}" Foreground="{StaticResource BrushText}" FontFamily="Segoe UI">
    <!-- Hintergrund explizit: der implizite Window-Stil aus App.xaml greift nicht für abgeleitete Fenster
         (siehe LedShapeEditorWindow). -->
    <Window.Resources>
        <!-- Werkzeug-Knopf: RadioButton im Button-Look, gewähltes Werkzeug violett. -->
        <Style x:Key="ToolRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource BrushPanelAlt}" BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccent}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==== Kopfzeile: Effekt öffnen/speichern ==== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <TextBlock Text="Effekt" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="EffectPicker" Width="220" DisplayMemberPath="Name" Margin="0,0,8,0"
                      ToolTip="Eigenen Effekt zum Bearbeiten öffnen" SelectionChanged="OnEffectPickerChanged" />
            <Button Content="Neu" Margin="0,0,16,0" Click="OnNewClick" ToolTip="Neuen, leeren Effekt beginnen" />
            <TextBlock Text="Name" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="NameBox" Width="220" Margin="0,0,16,0" TextChanged="OnNameChanged" />
            <Button x:Name="SaveButton" Content="💾  Speichern" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="OnSaveClick" ToolTip="Speichern (Strg+S)" />
            <Button x:Name="NextFrameButton" Content="➕  Nächster Frame" Margin="0,0,8,0" Click="OnNextFrameClick"
                    ToolTip="Neuen, leeren Frame hinter dem aktuellen anlegen und dorthin wechseln (N). Mit Shift: Kopie des aktuellen Frames." />
            <Button Content="Als Kopie speichern" Margin="0,0,8,0" Click="OnSaveCopyClick" />
            <Button x:Name="DeleteButton" Content="Löschen" Margin="0,0,16,0" Click="OnDeleteClick" />
            <Button Content="Importieren …" Margin="0,0,8,0" Click="OnImportClick" ToolTip=".aeffect-Datei übernehmen" />
            <Button x:Name="ExportButton" Content="Exportieren …" Margin="0,0,16,0" Click="OnExportClick" ToolTip="Als .aeffect-Datei speichern, z. B. zum Weitergeben" />
            <Button x:Name="UndoButton" Content="↶" Style="{StaticResource IconButton}" Click="OnUndoClick" ToolTip="Rückgängig (Strg+Z)" />
            <Button x:Name="RedoButton" Content="↷" Style="{StaticResource IconButton}" Click="OnRedoClick" ToolTip="Wiederholen (Strg+Y)" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- ==== Werkzeugleiste links ==== -->
            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <RadioButton x:Name="ToolBrush" GroupName="Tool" Style="{StaticResource ToolRadio}" Content="🖌" ToolTip="Pinsel (B) — Rechtsklick radiert, Alt = Pipette" IsChecked="True" Checked="OnToolChanged" />
                <RadioButton x:Name="ToolEraser" GroupName="Tool" Style="{StaticResource ToolRadio}" Content="⌫" ToolTip="Radierer (E) — radierte Zellen sind durchsichtig, die LEDs dort aus" Checked="OnToolChanged" />
                <RadioButton x:Name="ToolFill" GroupName="Tool" Style="{StaticResource ToolRadio}" Content="🪣" ToolTip="Füllen (G)" Checked="OnToolChanged" />
                <RadioButton x:Name="ToolLine" GroupName="Tool" Style="{StaticResource ToolRadio}" Content="╱" ToolTip="Linie (L) — Shift = in 45°-Schritten" Checked="OnToolChanged" />
                <RadioButton x:Name="ToolRect" GroupName="Tool" Style="{StaticResource ToolRadio}" Content="▭" ToolTip="Rechteck (R) — Shift = Quadrat" Checked="OnToolChanged" />
                <RadioButton x:Name="ToolEllipse" GroupName="Tool" Style="{StaticResource ToolRadio}" Content="◯" ToolTip="Ellipse (O) — Shift = Kreis" Checked="OnToolChanged" />
                <RadioButton x:Name="ToolPicker" GroupName="Tool" Style="{StaticResource ToolRadio}" Content="💧" ToolTip="Pipette (I) — Farbe von der Fläche aufnehmen" Checked="OnToolChanged" />
            </StackPanel>

            <!-- ==== Zeichenfläche + Zeitleiste ==== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="14" Background="#08090C" Padding="10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <Viewbox Stretch="Uniform">
                        <Grid x:Name="SurfaceRoot" Width="1600" Height="800" ClipToBounds="True">
                            <Image x:Name="PaintImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <!-- Zwiebelhaut: der vorige Frame scheint schwach durch (nur Anzeige, nie an den LEDs). -->
                            <Image x:Name="OnionImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" Opacity="0.3" IsHitTestVisible="False" />
                            <Rectangle x:Name="GridOverlay" IsHitTestVisible="False" />
                            <Canvas x:Name="DeviceOverlay" IsHitTestVisible="False" />
                            <!-- Anfasser der gewählten Animation: Mittelpunkt, Richtung beim Wandern -->
                            <Canvas x:Name="AnimOverlay" IsHitTestVisible="False" />
                            <Canvas x:Name="CursorOverlay" IsHitTestVisible="False" />
                            <Canvas x:Name="InputCanvas" Background="Transparent" Cursor="Cross"
                                    MouseDown="OnCanvasMouseDown" MouseMove="OnCanvasMouseMove" MouseUp="OnCanvasMouseUp"
                                    MouseLeave="OnCanvasMouseLeave" LostMouseCapture="OnCanvasLostCapture" />
                        </Grid>
                    </Viewbox>
                </Border>

                <!-- Zeitleiste: Miniaturen aller Frames der Mal-Ebene. Klick lädt den Frame in die Fläche. -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10" Margin="0,10,0,0">
                    <DockPanel>
                        <!-- Zeit: Abspielposition, Länge der Zeitleiste, Schleife -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PlayButton" Grid.Column="0" Content="▶  Abspielen" Margin="0,0,10,0" Click="OnPlayClick"
                                    ToolTip="Ganzen Effekt hier im Editor abspielen (Leertaste). Malen hält ihn an." />
                            <TextBlock x:Name="TimeText" Grid.Column="1" Style="{StaticResource MutedText}" VerticalAlignment="Center" MinWidth="96" Margin="0,0,8,0" />
                            <Slider x:Name="TimeSlider" Grid.Column="2" Minimum="0" Maximum="4" VerticalAlignment="Center" ValueChanged="OnTimeSliderChanged"
                                    ToolTip="Zeitpunkt wählen — die Fläche zeigt dann den ganzen Effekt mit allen Animationen" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0">
                                <TextBlock Text="Länge" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="DurationBox" Width="54" VerticalAlignment="Center" LostFocus="OnDurationCommit" KeyDown="OnDurationKeyDown"
                                         ToolTip="Länge der Zeitleiste in Sekunden (0,1–600)" />
                                <TextBlock Text="s" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="4,0,10,0" />
                                <CheckBox x:Name="AutoDurationCheck" Content="automatisch" VerticalAlignment="Center" Margin="0,0,10,0"
                                          Checked="OnAutoDurationChanged" Unchecked="OnAutoDurationChanged"
                                          ToolTip="Länge so wählen, dass sich alle Animationen, Keyframes und Frames nahtlos wiederholen" />
                                <ComboBox x:Name="LoopCombo" Width="140" SelectionChanged="OnLoopChanged" ToolTip="Was am Ende der Zeitleiste passiert">
                                    <ComboBoxItem Content="Schleife" />
                                    <ComboBoxItem Content="Hin und zurück" />
                                    <ComboBoxItem Content="Einmal, dann halten" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Keyframes der gewählten Ebene: eine Spur pro animiertem Wert -->
                        <Grid x:Name="KeyArea" DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="KeyLabels" Grid.Column="0" />
                            <Border Grid.Column="1" Background="{StaticResource BrushPanelAlt}" CornerRadius="6">
                                <Canvas x:Name="KeyTrack" Background="Transparent" ClipToBounds="True" MinHeight="22"
                                        MouseLeftButtonDown="OnKeyTrackMouseDown" MouseMove="OnKeyTrackMouseMove" MouseLeftButtonUp="OnKeyTrackMouseUp"
                                        SizeChanged="OnKeyTrackSizeChanged" />
                            </Border>
                        </Grid>

                        <TextBlock x:Name="FramesHint" DockPanel.Dock="Top" Style="{StaticResource MutedText}" Visibility="Collapsed" Margin="0,4,0,0"
                                   Text="Form-Ebene gewählt — Frames gibt es nur bei Mal-Ebenen." />
                        <DockPanel x:Name="FramesPanel">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Frames" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock x:Name="FrameInfoText" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,16,0" MinWidth="150" />
                            <Button Content="Duplizieren" Margin="0,0,8,0" Click="OnDuplicateFrameClick" ToolTip="Kopie des aktuellen Frames dahinter einfügen (Strg+D)" />
                            <Button x:Name="MoveFrameLeftButton" Content="◀" Style="{StaticResource IconButton}" Margin="0,0,4,0" Click="OnMoveFrameLeftClick" ToolTip="Frame eine Stelle nach vorn" />
                            <Button x:Name="MoveFrameRightButton" Content="▶" Style="{StaticResource IconButton}" Margin="0,0,8,0" Click="OnMoveFrameRightClick" ToolTip="Frame eine Stelle nach hinten" />
                            <Button x:Name="DeleteFrameButton" Content="Frame löschen" Margin="0,0,16,0" Click="OnDeleteFrameClick" ToolTip="Aktuellen Frame löschen" />
                            <TextBlock Text="Dauer pro Frame" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="FrameDurationBox" Width="60" VerticalAlignment="Center" LostFocus="OnFrameDurationCommit" KeyDown="OnFrameDurationKeyDown"
                                     ToolTip="Millisekunden, die jeder Frame zu sehen ist (20–10000). Das Tempo im Effekt-Fenster wirkt zusätzlich." />
                            <TextBlock Text="ms" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="4,0,16,0" />
                            <CheckBox x:Name="CrossFadeCheck" Content="Weich überblenden" VerticalAlignment="Center" Margin="0,0,12,0"
                                      Checked="OnCrossFadeChanged" Unchecked="OnCrossFadeChanged" ToolTip="Frames gehen ineinander über, statt hart umzuschalten" />
                            <CheckBox x:Name="OnionCheck" Content="Zwiebelhaut" IsChecked="True" VerticalAlignment="Center"
                                      Checked="OnOverlayOptionChanged" Unchecked="OnOverlayOptionChanged" ToolTip="Vorigen Frame schwach anzeigen (nur im Editor)" />
                        </WrapPanel>
                        <ScrollViewer x:Name="TimelineScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="OnTimelineMouseWheel">
                            <StackPanel x:Name="TimelinePanel" Orientation="Horizontal" Margin="0,0,0,4" />
                        </ScrollViewer>
                        </DockPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ==== Eigenschaften rechts ==== -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14" Margin="14,0,0,0">
                <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="ToolTabButton" Content="🖌  Werkzeug" Style="{StaticResource TabButton}" Margin="0,0,6,0" Tag="Active" Click="OnToolTabClick" />
                    <Button x:Name="LayerTabButton" Content="🎞  Ebenen &amp; Animation" Style="{StaticResource TabButton}" Margin="0" Click="OnLayerTabClick" />
                </StackPanel>

                <!-- Anzeige + Live: in beiden Reitern sichtbar -->
                <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,10,0,4" />
                        <TextBlock Text="Effekt-Fenster" Style="{StaticResource PanelLabel}" />
                        <ComboBox x:Name="SceneCombo" DisplayMemberPath="Name" SelectionChanged="OnSceneChanged"
                                  ToolTip="Dessen Geräte werden eingeblendet; dort läuft auch „Live auf LEDs“" />
                        <WrapPanel Margin="0,8,0,0">
                            <CheckBox x:Name="ShowDevicesCheck" Content="Geräte" IsChecked="True" Margin="0,0,12,4" Checked="OnOverlayOptionChanged" Unchecked="OnOverlayOptionChanged" ToolTip="Geräte des Effekt-Fensters einblenden" />
                            <CheckBox x:Name="ShowGridCheck" Content="Raster" IsChecked="True" Margin="0,0,12,4" Checked="OnOverlayOptionChanged" Unchecked="OnOverlayOptionChanged" />
                            <CheckBox x:Name="LiveCheck" Content="Live auf LEDs" Margin="0,0,0,4" Checked="OnLiveChanged" Unchecked="OnLiveChanged"
                                      ToolTip="Das gewählte Effekt-Fenster zeigt sofort, was du malst. Beim Ausschalten oder Schließen läuft dort wieder sein eigener Effekt." />
                        </WrapPanel>
                        <Button x:Name="UseInSceneButton" Content="Im Effekt-Fenster verwenden" Margin="0,6,0,0" Click="OnUseInSceneClick"
                                ToolTip="Speichern und als Effekt des gewählten Effekt-Fensters einstellen" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                    <StackPanel x:Name="ToolPanel">
                        <TextBlock x:Name="ToolTitle" Text="Pinsel" FontSize="16" FontWeight="SemiBold" />

                        <!-- Farbe -->
                        <StackPanel x:Name="ColorSection">
                            <TextBlock Text="Farbe" Style="{StaticResource PanelLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="ColorSwatch" Width="38" Height="38" CornerRadius="8" BorderThickness="1"
                                        BorderBrush="{StaticResource BrushBorder}" Cursor="Hand" ToolTip="Farbe wählen"
                                        MouseLeftButtonUp="OnColorSwatchClick" Margin="0,0,8,0" />
                                <TextBox x:Name="ColorHexBox" Width="90" VerticalAlignment="Center" ToolTip="Hex-Farbe, z. B. #FF8800"
                                         LostFocus="OnColorHexCommit" KeyDown="OnColorHexKeyDown" />
                            </StackPanel>
                            <WrapPanel x:Name="PalettePanel" Margin="0,8,0,0" />
                            <TextBlock Text="Zuletzt benutzt" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,2" />
                            <WrapPanel x:Name="RecentPanel" MinHeight="22" />
                        </StackPanel>

                        <!-- Pinsel/Radierer/Formen -->
                        <StackPanel x:Name="BrushSection">
                            <DockPanel Margin="0,10,0,4">
                                <TextBlock x:Name="SizeText" DockPanel.Dock="Right" Text="3" />
                                <TextBlock Text="Größe (Zellen)  − / +" Style="{StaticResource MutedText}" />
                            </DockPanel>
                            <Slider x:Name="SizeSlider" Minimum="1" Maximum="50" Value="3" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnBrushSettingChanged" />
                            <StackPanel x:Name="HardnessSection">
                                <DockPanel Margin="0,10,0,4">
                                    <TextBlock x:Name="HardnessText" DockPanel.Dock="Right" Text="100 %" />
                                    <TextBlock Text="Härte" Style="{StaticResource MutedText}" />
                                </DockPanel>
                                <Slider x:Name="HardnessSlider" Minimum="0" Maximum="100" Value="100" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="OnBrushSettingChanged" />
                                <TextBlock Text="Spitze" Style="{StaticResource PanelLabel}" />
                                <ComboBox x:Name="TipCombo" SelectionChanged="OnBrushSettingChanged">
                                    <ComboBoxItem Content="Rund" IsSelected="True" />
                                    <ComboBoxItem Content="Eckig" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="OpacitySection">
                            <DockPanel Margin="0,10,0,4">
                                <TextBlock x:Name="OpacityText" DockPanel.Dock="Right" Text="100 %" />
                                <TextBlock Text="Deckkraft" Style="{StaticResource MutedText}" />
                            </DockPanel>
                            <Slider x:Name="OpacitySlider" Minimum="5" Maximum="100" Value="100" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="OnBrushSettingChanged" />
                        </StackPanel>

                        <CheckBox x:Name="FilledCheck" Content="Gefüllt" Margin="0,12,0,0" ToolTip="Aus = nur Rahmen in Pinselgröße" />

                        <StackPanel x:Name="FillSection">
                            <DockPanel Margin="0,10,0,4">
                                <TextBlock x:Name="ToleranceText" DockPanel.Dock="Right" Text="0" />
                                <TextBlock Text="Toleranz" Style="{StaticResource MutedText}" />
                            </DockPanel>
                            <Slider x:Name="ToleranceSlider" Minimum="0" Maximum="128" Value="0" IsSnapToTickEnabled="True" TickFrequency="2" ValueChanged="OnBrushSettingChanged" />
                            <CheckBox x:Name="ContiguousCheck" Content="Nur zusammenhängende Fläche" IsChecked="True" Margin="0,8,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="SymmetrySection">
                            <TextBlock Text="Spiegeln beim Malen" Style="{StaticResource PanelLabel}" />
                            <CheckBox x:Name="MirrorHCheck" Content="Links ↔ rechts" Margin="0,2" />
                            <CheckBox x:Name="MirrorVCheck" Content="Oben ↕ unten" Margin="0,2" />
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0">
                            <WrapPanel>
                                <Button Content="Leeren" Margin="0,0,8,8" Click="OnClearClick" ToolTip="Alles durchsichtig machen (LEDs aus)" />
                                <Button Content="Mit Farbe füllen" Margin="0,0,0,8" Click="OnFloodAllClick" ToolTip="Ganze Fläche in der aktuellen Farbe" />
                            </WrapPanel>
                        </StackPanel>

                    </StackPanel>

                    <!-- Ebenen & Animation: Werte und Animationen werden im Code je nach Ebene aufgebaut -->
                    <StackPanel x:Name="LayerPanel" Visibility="Collapsed">
                        <TextBlock Text="Ebenen (oben = vorne)" Style="{StaticResource PanelLabel}" Margin="0,0,0,4" />
                        <ListBox x:Name="LayerList" Style="{StaticResource DeviceListBox}" MaxHeight="200" SelectionChanged="OnLayerSelectionChanged" />
                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="+ Malen" Margin="0,0,6,6" Click="OnAddPaintLayerClick" ToolTip="Neue, leere Mal-Ebene über der gewählten" />
                            <Button x:Name="AddShapeButton" Content="+ Form ▾" Margin="0,0,6,6" Click="OnAddShapeClick" ToolTip="Kreis, Ring oder Rechteck als eigene Ebene" />
                            <Button Content="▲" Style="{StaticResource IconButton}" Margin="0,0,2,6" Click="OnLayerUpClick" ToolTip="Ebene nach vorn" />
                            <Button Content="▼" Style="{StaticResource IconButton}" Margin="0,0,2,6" Click="OnLayerDownClick" ToolTip="Ebene nach hinten" />
                            <Button Content="⧉" Style="{StaticResource IconButton}" Margin="0,0,2,6" Click="OnDuplicateLayerClick" ToolTip="Ebene duplizieren" />
                            <Button Content="🗑" Style="{StaticResource IconButton}" Margin="0,0,0,6" Click="OnDeleteLayerClick" ToolTip="Ebene löschen" />
                        </WrapPanel>
                        <StackPanel x:Name="LayerProps" />

                        <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,12,0,8" />
                        <DockPanel Margin="0,0,0,6">
                            <Button x:Name="AddAnimButton" DockPanel.Dock="Right" Content="+ Animation ▾" Click="OnAddAnimationClick"
                                    ToolTip="Bewegungsvorlage zur gewählten Ebene hinzufügen" />
                            <TextBlock Text="Animationen" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ListBox x:Name="AnimList" Style="{StaticResource DeviceListBox}" MaxHeight="160" SelectionChanged="OnAnimSelectionChanged" />
                        <TextBlock x:Name="AnimHint" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="Noch keine Animation. Über „+ Animation“ lässt sich die Ebene wandern, wachsen, drehen, atmen oder die Farbe wechseln — ohne jedes Bild einzeln zu malen." />
                        <StackPanel x:Name="AnimProps" Margin="0,6,0,0" />
                    </StackPanel>
                    </Grid>
                </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ==== Statuszeile ==== -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="CellText" DockPanel.Dock="Right" Style="{StaticResource MutedText}" />
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
