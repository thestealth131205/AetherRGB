<UserControl x:Class="AetherRGB.App.EffectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Effekt-Player (links) ===================== -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Tabs der Effekt-Fenster + Plus -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <Button x:Name="AddSceneButton" DockPanel.Dock="Left" Content="+" Style="{StaticResource TabButton}"
                        FontSize="16" Padding="12,4" ToolTip="Neues Effekt-Fenster" Click="OnAddSceneClick" Margin="0" />
                <!-- Dropdown: welche Effekt-Fenster synchron laufen -->
                <Button x:Name="SyncButton" DockPanel.Dock="Right" Style="{StaticResource TabButton}" Content="⇄  Synchron ▾"
                        ToolTip="Effekt-Fenster wählen, die synchron miteinander laufen sollen" Click="OnSyncButtonClick" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SceneTabs" Orientation="Horizontal" />
                </ScrollViewer>
            </DockPanel>

            <!-- Effekt-Auswahl für das aktive Fenster -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="SceneNameBox" Grid.Column="1" Margin="0,0,16,0" TextChanged="OnSceneNameChanged" />
                <TextBlock Grid.Column="2" Text="Effekt" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="EffectCombo" Grid.Column="3" DisplayMemberPath="Name" Margin="0,0,10,0" SelectionChanged="OnEffectChanged" />
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button x:Name="PlayPauseButton" Style="{StaticResource PrimaryButton}" Content="⏸  Pausieren" Click="OnPlayPauseClick" />
                    <Button x:Name="EditorButton" Content="🎨  Effekt-Editor" Margin="8,0,0,0" Click="OnEditorClick"
                            ToolTip="Eigene Effekte malen — ist hier ein eigener Effekt gewählt, wird er zum Bearbeiten geöffnet" />
                </StackPanel>
                <!-- Farbwahl des Effekts — wird je nach Effekt in BuildEffectColorControls befüllt -->
                <WrapPanel x:Name="EffectColorPanel" Grid.Column="5" Margin="16,0,0,0" VerticalAlignment="Center" />
            </Grid>

            <!-- Fläche mit Live-Vorschau + platzierten Geräten -->
            <Border Grid.Row="2" CornerRadius="14" Background="#08090C" Padding="0">
                <Viewbox Stretch="Uniform">
                    <Grid x:Name="SurfaceRoot" Width="1600" Height="800">
                        <Image x:Name="PreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear" />
                        <Rectangle x:Name="GridOverlay" IsHitTestVisible="False" />
                        <Canvas x:Name="DeviceCanvas" Width="1600" Height="800" Background="Transparent" AllowDrop="True"
                                MouseLeftButtonDown="OnCanvasBackgroundClick" DragOver="OnCanvasDragOver" Drop="OnCanvasDrop" />
                        <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                   FontSize="28" Foreground="#C0FFFFFF" TextAlignment="Center"
                                   Text="Geräte aus der Liste rechts hierher ziehen" />
                    </Grid>
                </Viewbox>
            </Border>

            <!-- Eigenschaften des gewählten Geräts -->
            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <DockPanel>
                    <TextBlock x:Name="SelectedTitle" Text="Kein Gerät ausgewählt" FontSize="20" FontWeight="Bold" />
                </DockPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                    <Button x:Name="ShapeButton" Style="{StaticResource IconButton}" Content="⬚" ToolTip="LED-Anordnung bearbeiten" Click="OnEditShapeClick" />
                    <Button x:Name="CenterButton" Style="{StaticResource IconButton}" Content="⌖" ToolTip="Auf der Fläche zentrieren" Click="OnCenterClick" />
                    <Button x:Name="ResetRotationButton" Style="{StaticResource IconButton}" Content="↻" ToolTip="Rotation zurücksetzen" Click="OnResetRotationClick" />
                    <Button x:Name="RemoveButton" Style="{StaticResource IconButton}" Content="✕" ToolTip="Aus diesem Effekt-Fenster entfernen (Entf)" Click="OnRemoveClick" />
                </StackPanel>

                <Grid x:Name="FieldsGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="FieldX" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="FieldY" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}" />

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Breite" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="FieldWidth" Grid.Row="0" Grid.Column="3" Style="{StaticResource FieldBox}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Höhe" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="FieldHeight" Grid.Row="1" Grid.Column="3" Style="{StaticResource FieldBox}" />

                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Rotation" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="FieldRotation" Grid.Row="0" Grid.Column="5" Style="{StaticResource FieldBox}" />
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="Geräte-Helligkeit" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="FieldDeviceBrightness" Grid.Row="1" Grid.Column="5" Style="{StaticResource FieldBox}" />

                    <TextBlock Grid.Row="0" Grid.Column="6" Text="Layout-Helligkeit" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="FieldLayoutBrightness" Grid.Row="0" Grid.Column="7" Style="{StaticResource FieldBox}" />
                </Grid>

                <!-- Spiel-Anzeige: Bereiche eines Bildschirm-Profils dem gewählten Gerät zuweisen (BuildGamePanel) -->
                <StackPanel x:Name="GamePanel" Margin="0,12,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- ===================== Geräteliste (rechts) ===================== -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14" Margin="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Geräte" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Auf die Effekt-Fläche ziehen. Doppelklick = LED-Anordnung festlegen." Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" FontSize="12" Margin="0,2,0,10" />
                </StackPanel>

                <!-- WLED manuell / Suche -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock Text="WLED hinzufügen" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox x:Name="WledNameBox" Margin="0,0,0,6" ToolTip="Name (optional)" />
                    <TextBox x:Name="WledHostBox" Margin="0,0,0,8" ToolTip="IP-Adresse oder Hostname, z. B. 192.168.1.50" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Per IP hinzufügen" Padding="6,8" Click="OnWledAddClick" />
                        <Button x:Name="WledDiscoverButton" Grid.Column="2" Content="Im Netz suchen" Padding="6,8" Click="OnWledDiscoverClick" />
                    </Grid>
                    <TextBlock x:Name="WledHintText" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Name / IP oben eintragen. Die Suche nutzt mDNS nur im lokalen Netz." />
                </StackPanel>

                <ListBox x:Name="DeviceListBox" Style="{StaticResource DeviceListBox}"
                         PreviewMouseLeftButtonDown="OnDeviceListMouseDown" PreviewMouseMove="OnDeviceListMouseMove"
                         MouseDoubleClick="OnDeviceListDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Background="Transparent" Cursor="Hand">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource MutedText}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
