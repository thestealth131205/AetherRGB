<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AetherRGB.App</RootNamespace>
    <AssemblyName>AetherRGB</AssemblyName>
    <Version>0.3.7</Version>
    <AssemblyVersion>0.3.7.0</AssemblyVersion>
    <FileVersion>0.3.7.0</FileVersion>
    <Product>AetherRGB</Product>
    <Company>thestealth131205</Company>
    <!-- Logo (erzeugt von tools/make_icon.py): EXE-/Taskleisten-Symbol; WPF-Fenster ohne eigenes
         Icon übernehmen es automatisch. -->
    <ApplicationIcon>Assets\AetherRGB.ico</ApplicationIcon>
    <!-- Bewusst KEIN InvariantGlobalization: WPF braucht echte Kulturdaten für die Text-Engine
         (MS.Internal.FontCache.MajorLanguages erzeugt CultureInfo("en") usw.) — im
         Invariant-Modus wirft das beim ersten TextBlock-Measure eine CultureNotFoundException
         und die App stürzt direkt beim Start ab. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms bringt automatisch globale Usings für System.Windows.Forms/System.Drawing
         mit (für den Tray-Icon/NotifyIcon) — die kollidieren mit WPF-Typen gleichen Namens
         (Application, Point, Brush, MouseEventArgs) in den bestehenden Dateien. Die expliziten
         Aliase (Forms./Drawing.) in MainWindow.xaml.cs funktionieren weiterhin ohne die globalen Usings. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray-Symbol (NotifyIcon braucht ein System.Drawing.Icon) und Logo in der Seitenleiste -->
    <EmbeddedResource Include="Assets\AetherRGB.ico" LogicalName="AetherRGB.ico" />
    <Resource Include="Assets\AetherRGB-64.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AetherRGB.Core\AetherRGB.Core.csproj" />
    <ProjectReference Include="..\AetherRGB.Providers.OpenRGB\AetherRGB.Providers.OpenRGB.csproj" />
    <ProjectReference Include="..\AetherRGB.Providers.Wled\AetherRGB.Providers.Wled.csproj" />
    <ProjectReference Include="..\AetherRGB.Providers.HomeAssistant\AetherRGB.Providers.HomeAssistant.csproj" />
    <ProjectReference Include="..\AetherRGB.Providers.MsiMysticLight\AetherRGB.Providers.MsiMysticLight.csproj" />
    <ProjectReference Include="..\AetherRGB.Api\AetherRGB.Api.csproj" />
  </ItemGroup>

</Project>
