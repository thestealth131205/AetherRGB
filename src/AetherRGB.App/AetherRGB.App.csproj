<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AetherRGB.App</RootNamespace>
    <AssemblyName>AetherRGB</AssemblyName>
    <Version>0.3.20</Version>
    <AssemblyVersion>0.3.20.0</AssemblyVersion>
    <FileVersion>0.3.20.0</FileVersion>
    <Product>AetherRGB</Product>
    <!-- Bildschirmaufnahme: gemappte DXGI-Textur direkt als Span lesen statt 8 MB pro Bild zu kopieren. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Company>thestealth131205</Company>
    <!-- Logo (erzeugt von tools/make_icon.py): EXE-/Taskleisten-Symbol; WPF-Fenster ohne eigenes
         Icon übernehmen es automatisch. -->
    <ApplicationIcon>Assets\AetherRGB.ico</ApplicationIcon>
    <!-- Bewusst KEIN InvariantGlobalization: WPF braucht echte Kulturdaten für die Text-Engine
         (MS.Internal.FontCache.MajorLanguages erzeugt CultureInfo("en") usw.) — im
         Invariant-Modus wirft das beim ersten TextBlock-Measure eine CultureNotFoundException
         und die App stürzt direkt beim Start ab. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms bringt automatisch globale Usings für System.Windows.Forms/System.Drawing
         mit (für den Tray-Icon/NotifyIcon) — die kollidieren mit WPF-Typen gleichen Namens
         (Application, Point, Brush, MouseEventArgs) in den bestehenden Dateien. Die expliziten
         Aliase (Forms./Drawing.) in MainWindow.xaml.cs funktionieren weiterhin ohne die globalen Usings. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray-Symbol (NotifyIcon braucht ein System.Drawing.Icon) und Logo in der Seitenleiste -->
    <EmbeddedResource Include="Assets\AetherRGB.ico" LogicalName="AetherRGB.ico" />
    <Resource Include="Assets\AetherRGB-64.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Chroma-Bridge (Ersatz für RzChromaSDK64.dll), baut die CI vorher mit MSVC aus native/ChromaBridge.
         Fehlt sie (lokaler Build), kann die App sie eben nicht installieren. -->
    <EmbeddedResource Include="..\..\native\ChromaBridge\bin\x64\RzChromaSDK64.dll" LogicalName="ChromaBridge.x64.dll"
                      Condition="Exists('..\..\native\ChromaBridge\bin\x64\RzChromaSDK64.dll')" />
    <EmbeddedResource Include="..\..\native\ChromaBridge\bin\x86\RzChromaSDK.dll" LogicalName="ChromaBridge.x86.dll"
                      Condition="Exists('..\..\native\ChromaBridge\bin\x86\RzChromaSDK.dll')" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bildschirm-Sync: Desktop Duplication (DXGI), wie OBS. MIT-Lizenz. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <!-- Kühlung: Lüfter erkennen/steuern über die Super-I/O-Chips auf dem Mainboard. Dieselbe,
         geprüfte Bibliothek, die auch FanControl und OpenHardwareMonitor nutzen — bewusst kein
         eigener SMBus/EC-Zugriff (gleiche Begründung wie beim OpenRGB-SDK für Motherboard-ARGB).
         MPL-2.0-Lizenz. Braucht Adminrechte (lädt den WinRing0-Treiber). -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AetherRGB.Core\AetherRGB.Core.csproj" />
    <ProjectReference Include="..\AetherRGB.Providers.OpenRGB\AetherRGB.Providers.OpenRGB.csproj" />
    <ProjectReference Include="..\AetherRGB.Providers.Wled\AetherRGB.Providers.Wled.csproj" />
    <ProjectReference Include="..\AetherRGB.Providers.HomeAssistant\AetherRGB.Providers.HomeAssistant.csproj" />
    <ProjectReference Include="..\AetherRGB.Providers.MsiMysticLight\AetherRGB.Providers.MsiMysticLight.csproj" />
    <ProjectReference Include="..\AetherRGB.Providers.Redragon\AetherRGB.Providers.Redragon.csproj" />
    <ProjectReference Include="..\AetherRGB.Api\AetherRGB.Api.csproj" />
  </ItemGroup>

</Project>
