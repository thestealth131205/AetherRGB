<Window x:Class="AetherRGB.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AetherRGB.App"
        Title="AetherRGB" MinWidth="1180" MinHeight="720"
        Width="1500" Height="880"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar (immer offen) ===================== -->
        <Border Grid.Column="0" Background="{StaticResource BrushSidebar}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,24">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/AetherRGB-64.png" Width="32" Height="32" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                        <TextBlock Text="AetherRGB" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="SidebarStatusText" Text="Nicht verbunden" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="NavDevicesButton" Style="{StaticResource NavButton}" Tag="Active" Click="OnNavClick">
                        <TextBlock Text="🖥  Geräte" />
                    </Button>
                    <Button x:Name="NavEffectsButton" Style="{StaticResource NavButton}" Click="OnNavClick">
                        <TextBlock Text="🎨  Effekte &amp; Layout" />
                    </Button>
                    <Button x:Name="NavSettingsButton" Style="{StaticResource NavButton}" Click="OnNavClick">
                        <TextBlock Text="⚙  Einstellungen" />
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,20">
                    <Button x:Name="RepairButton" Content="Reparieren" Margin="0,0,0,8" Click="OnRepairClick" />
                    <Button x:Name="UpdateButton" Content="Nach Updates suchen" Click="OnCheckUpdateClick" />
                </StackPanel>

                <Grid />
            </DockPanel>
        </Border>

        <!-- ===================== Hauptbereich ===================== -->
        <Grid Grid.Column="1" Background="{StaticResource BrushBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ==== Seite: Geräte ==== -->
            <Grid x:Name="PageDevices" Grid.Row="0" Margin="32,28,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Geräte" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="" Margin="16,0,0,0" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                    <Button x:Name="ConnectButton" Content="Geräte neu suchen" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="OnConnectClick" />
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                    <ListView x:Name="DeviceList" BorderThickness="0" Background="Transparent">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Gerät" Width="340" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Hersteller" Width="200" DisplayMemberBinding="{Binding Vendor}" />
                                <GridViewColumn Header="Zonen/LEDs" Width="220" DisplayMemberBinding="{Binding ZoneSummary}" />
                                <GridViewColumn Header="Status" Width="140" DisplayMemberBinding="{Binding StatusText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </Grid>

            <!-- ==== Seite: Effekte und Layout ==== -->
            <Grid x:Name="PageEffects" Grid.Row="0" Margin="32,24,32,16" Visibility="Collapsed">
                <local:EffectsView x:Name="EffectsPanel" />
            </Grid>

            <!-- ==== Seite: Einstellungen ==== -->
            <Grid x:Name="PageSettings" Grid.Row="0" Margin="32,28,32,16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Einstellungen" Style="{StaticResource SectionTitle}" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Start -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="StartWithWindowsCheck" Content="Mit Windows starten (minimiert im Infobereich)" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="AetherRGB startet beim Anmelden ohne Fenster und steuert die LEDs gleich mit den gespeicherten Effekten. Öffnen per Doppelklick auf das Symbol neben der Uhr. Mit dem Mystic Light SDK richtet AetherRGB den Autostart über die Aufgabenplanung mit Administratorrechten ein, sobald es einmal als Administrator lief." />
                            </StackPanel>
                        </Border>

                        <!-- OpenRGB -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="OpenRgbEnabledCheck" Content="OpenRGB-Server" FontWeight="SemiBold" />
                                <TextBlock Text="Für ASUS Aura, ASRock Polychrome, Gigabyte RGB Fusion, MSI Mystic Light u.v.m. — erfordert einen laufenden OpenRGB-Server." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="OpenRgbHostBox" Grid.Column="0" Margin="0,0,8,0" />
                                    <TextBox x:Name="OpenRgbPortBox" Grid.Column="1" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- MSI Mystic Light -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="MSI Mystic Light" FontWeight="SemiBold" />
                                <TextBlock x:Name="MsiBoardText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,10" />

                                <RadioButton x:Name="MsiBackendSdk" GroupName="MsiBackend" Foreground="{StaticResource BrushText}" Margin="0,3"
                                             Content="Offizielles Mystic Light SDK (über MSI Center)" Checked="OnMsiBackendChanged" />
                                <RadioButton x:Name="MsiBackendHid" GroupName="MsiBackend" Foreground="{StaticResource BrushText}" Margin="0,3"
                                             Content="Eigene Variante: direkt per USB/HID (experimentell, ohne MSI Center)" Checked="OnMsiBackendChanged" />
                                <RadioButton x:Name="MsiBackendOff" GroupName="MsiBackend" Foreground="{StaticResource BrushText}" Margin="0,3"
                                             Content="Nicht direkt steuern (z. B. über OpenRGB)" Checked="OnMsiBackendChanged" />

                                <!-- SDK -->
                                <StackPanel x:Name="MsiSdkPanel" Margin="0,12,0,0">
                                    <TextBlock Text="Pfad zur MysticLight_SDK_x64.dll (leer = Programmordner oder %APPDATA%\AetherRGB)" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="MsiSdkPathBox" Grid.Column="0" Margin="0,0,8,0" TextChanged="OnMsiSdkPathChanged" />
                                        <Button Grid.Column="1" Content="Durchsuchen …" Click="OnMsiSdkBrowseClick" />
                                    </Grid>
                                    <TextBlock x:Name="MsiSdkStatusText" TextWrapping="Wrap" Foreground="{StaticResource BrushText}" Margin="0,0,0,10" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Max. Farb-Updates pro Sekunde:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox x:Name="MsiSdkRateBox" Width="60" />
                                    </StackPanel>
                                    <TextBlock Text="Standard 10, höchstens 60. Ein Aufruf dauert je Anschluss ~30 ms, mit 3 Anschlüssen sind also ~10 Runden/s die Obergrenze — höhere Werte bringen dann nichts, belasten den Controller aber stärker. Meldet der MSI-Dienst Fehler oder hängt der Controller (Board-LEDs flackern, Windows meldet USB trennen/verbinden), senkt AetherRGB das Tempo automatisch und hebt es nach 30 s ohne Probleme wieder an. Kommt das oft vor, den Wert hier dauerhaft senken."
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                    <CheckBox x:Name="MsiSdkPerLedCheck" Margin="0,12,0,4"
                                              Content="ARGB-Anschlüsse LED für LED steuern (Direct Lighting Control)" />
                                    <TextBlock Text="PCH (6 LEDs) und JRAINBOW (WS2812-Strips, bis 100 LEDs) zeigen dann den Effekt pro LED. Die tatsächliche Strip-Länge legst du über die LED-Anordnung des Geräts fest. Aus = jeder Anschluss zeigt eine Mischfarbe."
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                    <CheckBox x:Name="MsiSdkUsedLedsCheck" Margin="0,12,0,4"
                                              Content="Nur die belegten LEDs senden" />
                                    <TextBlock Text="Belegt die LED-Anordnung z. B. 20 von 100 LEDs eines JRAINBOW-Anschlusses, werden die übrigen einmal schwarz gesetzt und danach nur noch die 20 gesendet. Lehnt das Board das ab, sendet AetherRGB automatisch wieder alle LEDs."
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Eigene HID-Variante -->
                                <StackPanel x:Name="MsiHidPanel" Margin="0,12,0,0">
                                    <TextBlock Text="Erstmals am MSI MPG B550 Gaming Plus getestet. MSI Center dabei beenden. Vor echten Effekten zuerst den sicheren Einzel-Test machen."
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="LED-Anzahl (Sammelzone):" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox x:Name="MsiLedCountBox" Width="80" />
                                    </StackPanel>
                                    <Button x:Name="MsiTestButton" Content="MSI-HID-Test (Einzel-LED, sicher)" HorizontalAlignment="Left" Click="OnMsiTestClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- WLED -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="WLED-Instanzen" FontWeight="SemiBold" Margin="0,0,0,2" />
                                <TextBlock Text="Lokale ESP32/ESP8266-WLED-Controller per IP-Adresse oder Hostname, direkt im Heimnetz — keine Cloud." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,10" />
                                <ListView x:Name="WledList" Height="110" Margin="0,0,0,10">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding Name}" />
                                            <GridViewColumn Header="Host/IP" Width="220" DisplayMemberBinding="{Binding Host}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WledNameBox" Grid.Column="0" Margin="0,0,8,0" Tag="Name (z.B. Schreibtisch)" />
                                    <TextBox x:Name="WledHostBox" Grid.Column="1" Margin="0,0,8,0" Tag="IP/Host" />
                                    <Button x:Name="WledAddButton" Grid.Column="2" Content="Hinzufügen" Margin="0,0,8,0" Click="OnWledAddClick" />
                                    <Button x:Name="WledRemoveButton" Grid.Column="3" Content="Entfernen" Click="OnWledRemoveClick" />
                                </Grid>
                                <CheckBox x:Name="WledUdpCheck" Margin="0,12,0,4" Content="Effekte per UDP-Echtzeit senden (DRGB/DNRGB)" />
                                <TextBlock Text="Ein UDP-Paket pro Bild statt eines HTTP-Aufrufs — flüssig mit 30 Bildern/s. In WLED muss unter Config → Sync Interfaces „Receive UDP realtime“ an sein (Standard). Hört AetherRGB auf zu senden, zeigt WLED nach 2 s wieder seinen eigenen Effekt. Aus = Senden über die JSON-API wie bisher."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Home Assistant -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="HaEnabledCheck" Content="Home Assistant" FontWeight="SemiBold" />
                                <TextBlock Text="Steuert/liest HA-Lichter über die lokale REST-API deiner Home-Assistant-Instanz — keine Cloud-Anbindung." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,10" />
                                <TextBlock Text="Basis-URL" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                                <TextBox x:Name="HaUrlBox" Margin="0,0,0,10" />
                                <TextBlock Text="Long-Lived Access Token" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                                <PasswordBox x:Name="HaTokenBox" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Lichter höchstens alle" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="HaIntervalBox" Width="50" />
                                    <TextBlock Text="Sekunden aktualisieren" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="Mindestens 3 s. Ein HA-Licht bekommt dann den Mittelwert der Effektfarben seit dem letzten Befehl — Lampen und Funknetze (Zigbee, WLAN) vertragen keine 30 Befehle pro Sekunde. Unveränderte Farben werden nicht erneut gesendet, Schwarz schaltet das Licht aus."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                <CheckBox x:Name="HaTransitionCheck" Margin="0,12,0,4" Content="Weich überblenden (HA-Parameter „transition“)" />
                                <TextBlock Text="Lampen, die das können, blenden über das ganze Intervall zur neuen Farbe über, statt zu springen."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Lokale API -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="LocalApiEnabledCheck" Content="Lokale offene API" FontWeight="SemiBold" />
                                <TextBlock Text="Nur für Anwendungen auf diesem PC (127.0.0.1) — keine Serverkommunikation nach außen." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="LocalApiPortBox" Width="100" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button x:Name="SettingsSaveButton" Content="Speichern &amp; Geräte neu verbinden" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Padding="20,10" Click="OnSettingsSaveClick" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ==== Log-Leiste unten, immer sichtbar ==== -->
            <Border Grid.Row="1" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="20,8,12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Neueste Zeile unten (scrollt mit, solange man unten steht); Zeitstempel und Stufe pro Zeile, Warnungen/Fehler farbig. -->
                    <ScrollViewer x:Name="LogScroll" Grid.Column="0" Height="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="LogList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:LogEntry}">
                                    <TextBlock x:Name="Line" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource BrushText}">
                                        <Run Text="{Binding TimeText, Mode=OneTime}" Foreground="{StaticResource BrushTextMuted}" />
                                        <Run Text="{Binding LevelText, Mode=OneTime}" />
                                        <Run Text="{Binding Message, Mode=OneTime}" />
                                    </TextBlock>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="Debug">
                                            <Setter TargetName="Line" Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                                            <Setter TargetName="Line" Property="Foreground" Value="{StaticResource BrushWarning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                            <Setter TargetName="Line" Property="Foreground" Value="{StaticResource BrushDanger}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0">
                        <Button x:Name="LogSaveButton" Content="💾 Speichern" Padding="12,6" Click="OnLogSaveClick"
                                ToolTip="Angezeigtes Log als Textdatei speichern" />
                        <TextBlock x:Name="LogCountText" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
