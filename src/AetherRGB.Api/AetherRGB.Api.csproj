<Project Sdk="Microsoft.NET.Sdk">

  <!-- Bewusst Microsoft.NET.Sdk statt Microsoft.NET.Sdk.Web: dies ist eine Klasssenbibliothek
       (LocalApiHost wird von AetherRGB.App gehostet), kein eigenständig startbares Webprojekt.
       Microsoft.NET.Sdk.Web erwartet einen Einstiegspunkt (Main) und schlägt hier fehl. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AetherRGB.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\AetherRGB.Core\AetherRGB.Core.csproj" />
  </ItemGroup>

</Project>
